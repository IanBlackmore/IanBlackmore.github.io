c","metadata":{"contentType":"Video","license":"U","title":"Bad Email"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"","subtitle":""},"contentBehaviour":"enabled","nextContentId":3},{"type":{"library":"H5P.BranchingQuestion 1.0","params":{"branchingQuestion":{"alternatives":[{"nextContentId":4,"feedback":{"title":"","subtitle":""},"text":"Click the link."},{"nextContentId":5,"feedback":{"title":"","subtitle":""},"text":"Delete the email and report it."},{"nextContentId":6,"feedback":{"title":"","subtitle":""},"text":"Forward to a coworker asking if it&#039;s real."}],"question":"<p>What should Tanya do?&nbsp;<\/p>"}},"subContentId":"1bf41d7c-bc4c-4f6a-b441-77b21e1f727b","metadata":{"contentType":"Branching Question","license":"U","title":"Untitled Branching Question"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"","subtitle":""},"contentBehaviour":"enabled"},{"type":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":false,"controls":true},"playback":{"autoplay":true,"loop":false},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":"Video is missing sources.","aborted":"Media playback has been aborted.","networkFailure":"Network failure.","cannotDecode":"Unable to decode media.","formatNotSupported":"Video format not supported.","mediaEncrypted":"Media encrypted.","unknownError":"Unknown error.","invalidYtId":"Invalid YouTube ID.","unknownYtId":"Unable to find video with the given YouTube ID.","restrictedYt":"The owner of this video does not allow it to be embedded."},"sources":[{"path":"videos\/sources-689c91ae5ee8b.mp4","mime":"video\/mp4","copyright":{"license":"U"}}]},"subContentId":"3c6e6b0e-3397-4325-800b-d69607f7905e","metadata":{"contentType":"Video","license":"U","title":"Scenario A"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"<p>Incorrect Choice!&nbsp;<\/p>","image":{"path":"images\/image-689c9214ee09d.jpg","mime":"image\/jpeg","copyright":{"license":"U"},"width":1300,"height":921},"subtitle":"<p>Never click on a link from a suspicious email! Check spelling, sender address, and look for any oddities in the email to check if its authentic or not. &nbsp;<\/p><p>Clicking the link installs ransomware, which can shut down the systems! &nbsp;That means no care for Consumers who need it and potential delays in payments.&nbsp;<\/p>"},"contentBehaviour":"enabled","nextContentId":14},{"type":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":true,"controls":true},"playback":{"autoplay":true,"loop":false},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":"Video is missing sources.","aborted":"Media playback has been aborted.","networkFailure":"Network failure.","cannotDecode":"Unable to decode media.","formatNotSupported":"Video format not supported.","mediaEncrypted":"Media encrypted.","unknownError":"Unknown error.","invalidYtId":"Invalid YouTube ID.","unknownYtId":"Unable to find video with the given YouTube ID.","restrictedYt":"The owner of this video does not allow it to be embedded."},"sources":[{"path":"videos\/sources-689c92b0154a3.mp4","mime":"video\/mp4","copyright":{"license":"U"}}]},"subContentId":"68bc4238-e616-4390-b2cc-6adca45b6579","metadata":{"contentType":"Video","license":"U","title":"Scenario B"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"<p>Correct Choice!&nbsp;<\/p>","subtitle":"<p>This is the best course of action! &nbsp;Delete the email and report it to the appropriate department. &nbsp;If you're unsure, its always best to check with IT than to click the link!&nbsp;<\/p>","image":{"path":"images\/image-689c930ee7964.jpg","mime":"image\/jpeg","copyright":{"license":"U"},"width":1000,"height":1000}},"contentBehaviour":"enabled","nextContentId":14},{"type":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":true,"controls":true},"playback":{"autoplay":true,"loop":false},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":"Video is missing sources.","aborted":"Media playback has been aborted.","networkFailure":"Network failure.","cannotDecode":"Unable to decode media.","formatNotSupported":"Video format not supported.","mediaEncrypted":"Media encrypted.","unknownError":"Unknown error.","invalidYtId":"Invalid YouTube ID.","unknownYtId":"Unable to find video with the given YouTube ID.","restrictedYt":"The owner of this video does not allow it to be embedded."},"sources":[{"path":"videos\/sources-689c92c59024e.mp4","mime":"video\/mp4","copyright":{"license":"U"}}]},"subContentId":"a5c1ad72-0bf0-4ba2-9eb1-b6ed2e61bf57","metadata":{"contentType":"Video","license":"U","title":"Scenario C"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"<p>Incorrect Choice!&nbsp;<\/p>","subtitle":"<p>This seems harmless, but your coworker could be distracted and click on the link without paying attention and install Ransomware by accident! &nbsp;This is risk spreading. &nbsp;The best course of action if you are unsure is to report it to IT or <a href=\"mailto:spam@ilwr.ca\">spam@ilwr.ca<\/a>.&nbsp;<\/p>","image":{"path":"images\/image-689c937f10857.jpg","mime":"image\/jpeg","copyright":{"license":"U"},"width":1300,"height":921}},"contentBehaviour":"useBehavioural","nextContentId":14},{"type":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":false,"controls":true},"playback":{"autoplay":true,"loop":false},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":