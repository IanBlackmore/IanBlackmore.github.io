tContentId":9},{"type":{"library":"H5P.BranchingQuestion 1.0","params":{"branchingQuestion":{"alternatives":[{"nextContentId":10,"feedback":{"title":"","subtitle":""},"text":"&quot;Hi Brian. I&#039;m glad we have a good connection, but I have to keep our relationship professional. I can&#039;t text outside of work."},{"nextContentId":11,"feedback":{"title":"","subtitle":""},"text":"Choose to NOT RESPOND"},{"nextContentId":12,"feedback":{"title":"","subtitle":""},"text":"&quot;Aw thanks Brian! You&#039;re my favorite too!&quot;"}],"question":"<p>How should you, as the Attendant, respond to this text? &nbsp;\"Hey, it's Brian. I got your number online. &nbsp;Just wanted to say I really enjoy when you're here. &nbsp;I feel we're becoming good friends!\"&nbsp;<\/p>"}},"subContentId":"1b53d79d-0688-4be6-9bd6-2b3391ee02fa","metadata":{"contentType":"Branching Question","license":"U","title":"Brian Question"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"","subtitle":""},"contentBehaviour":"useBehavioural"},{"type":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":true,"controls":true},"playback":{"autoplay":true,"loop":false},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":"Video is missing sources.","aborted":"Media playback has been aborted.","networkFailure":"Network failure.","cannotDecode":"Unable to decode media.","formatNotSupported":"Video format not supported.","mediaEncrypted":"Media encrypted.","unknownError":"Unknown error.","invalidYtId":"Invalid YouTube ID.","unknownYtId":"Unable to find video with the given YouTube ID.","restrictedYt":"The owner of this video does not allow it to be embedded."},"sources":[{"path":"videos\/sources-689c971668d1a.mp4","mime":"video\/mp4","copyright":{"license":"U"}}]},"subContentId":"4fd05147-717b-4ac1-a0d8-e488bcb95cba","metadata":{"contentType":"Video","license":"U","title":"Scenario A"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"<p>Correct Choice!&nbsp;<\/p>","subtitle":"<p>Brian responds a bit awkwardly but backs off. You notify your supervisor and document the contact.&nbsp;&nbsp;This is the best scenario as Brian understands your boundaries and knows to keep things professional. &nbsp;<\/p>","image":{"path":"images\/image-689c98765fd20.jpg","mime":"image\/jpeg","copyright":{"license":"U"},"width":1000,"height":1000}},"contentBehaviour":"useBehavioural","nextContentId":13},{"type":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":true,"controls":true},"playback":{"autoplay":true,"loop":false},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":"Video is missing sources.","aborted":"Media playback has been aborted.","networkFailure":"Network failure.","cannotDecode":"Unable to decode media.","formatNotSupported":"Video format not supported.","mediaEncrypted":"Media encrypted.","unknownError":"Unknown error.","invalidYtId":"Invalid YouTube ID.","unknownYtId":"Unable to find video with the given YouTube ID.","restrictedYt":"The owner of this video does not allow it to be embedded."},"sources":[{"path":"videos\/sources-689c972d34047.mp4","mime":"video\/mp4","copyright":{"license":"U"}}]},"subContentId":"35e81c60-ffb4-4fb6-af76-02ab4010de5a","metadata":{"contentType":"Video","license":"U","title":"Scenario B"}},"showContentTitle":false,"proceedButtonText":"Proceed","forceContentFinished":"useBehavioural","feedback":{"title":"<p>Incorrect Choice!&nbsp;<\/p>","subtitle":"<p>Choosing not to respond doesn't resolve the problem and can lead to the Consumer continuing to text you after service hours. &nbsp;<\/p>","image":{"path":"images\/image-689c9a5d132a0.jpg","mime":"image\/jpeg","copyright":{"license":"U"},"width":1300,"height":921}},"contentBehaviour"